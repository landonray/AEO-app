# Neon Postgres connection string (required)
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

NODE_ENV=development
PORT=4810

# Optional: extra hosts allowed to open the dev server (comma-separated),
# e.g. a LAN or Tailscale IP, or a tunnel hostname. Not needed for localhost.
# ALLOWED_DEV_ORIGINS=192.168.1.20,aeo.example.com

# LLM Gateway (OpenAI, Claude, Gemini) — a private gateway, not a public service.
# See the README section "About the LLM Gateway" before filling these in.
LLM_GATEWAY_BASE_URL=https://your-llm-gateway.example.com/api/v1
LLM_GATEWAY_API_KEY=llmgw_REPLACE_ME

# Tracking models — frontier consumer-tier (must match the gateway's model list)
MODEL_OPENAI=gpt-6.1-sol
MODEL_CLAUDE=claude-opus-5-5
MODEL_GEMINI=gemini-3.1-pro-preview

# Generation model — cheap, internal plumbing only (crawl/prompt/competitor gen)
MODEL_GENERATION=gemini-2.5-flash

# Perplexity — called directly (not via gateway)
PERPLEXITY_API_KEY=pplx-REPLACE_ME
MODEL_PERPLEXITY=sonar-pro

# DataForSEO (Google AI Overview SERP scraping)
DATAFORSEO_LOGIN=you@example.com
DATAFORSEO_PASSWORD=REPLACE_ME

# Scheduler auth (protects the cron endpoint) — generate a long random string
CRON_SECRET=REPLACE_ME
